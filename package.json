{
  "name": "jexop",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geee-be/jexop.git"
  },
  "license": "MIT",
  "author": "Greg Bacchus",
  "type": "module",
  "scripts": {
    "build": "pnpm --stream -r build",
    "build:docs": "pnpm --stream --parallel -r build:docs",
    "change": "changeset",
    "changes": "changeset",
    "changeset": "changeset",
    "lint": "biome ci . && pnpm --stream -r lint:types && knip",
    "lint:biome": "biome ci .",
    "lint:biome:fix": "biome check --write .",
    "start:dev": "pnpm --stream --parallel -r start:dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "knip": "^6.43.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12"
  }
}
