{
  "name": "@jexop/core",
  "version": "1.1.3",
  "description": "Evaluate expressions with operators that are represented purely JSON objects",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geee-be/jexop.git",
    "directory": "packages/@jexop/core"
  },
  "license": "MIT",
  "author": "Greg Bacchus",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@jexop/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:docs": "pnpx md-aggregate ./INTRO.md ./src/operators/array/README.md ./src/operators/boolean/README.md ./src/operators/branch/README.md ./src/operators/equality/README.md ./src/operators/numeric/README.md ./src/operators/object/README.md > README.md",
    "lint:types": "tsc -p tsconfig.json",
    "start:dev": "tsc -p tsconfig.esm.json --watch"
  }
}
